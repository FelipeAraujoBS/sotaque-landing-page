{
  "name": "temp-setup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=chromium tests/e2e/a11y.spec.ts",
    "test:seo": "playwright test tests/e2e/seo.spec.ts",
    "lhci": "lhci autorun",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "framer-motion": "^13.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^28.1.0",
    "msw": "^3.0.1",
    "postcss": "^8",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
