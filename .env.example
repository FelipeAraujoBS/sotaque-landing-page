# ==============================================================================
# SOTAQUE ESTÚDIO 360 — VARIÁVEIS DE AMBIENTE (PRODUÇÃO & DESENVOLVIMENTO)
# ==============================================================================
# Copie este arquivo para .env.local (em dev) ou configure no painel de hospedagem
# (Vercel, Netlify, Cloudflare Pages, VPS, etc.).

# 1. URL PÚBLICA DO SITE (SEO, SITEMAP & OPEN GRAPH)
# Usado para gerar URLs canônicas em sitemap.xml, robots.txt e tags de compartilhamento.
NEXT_PUBLIC_SITE_URL="https://sotaquecom.com.br"

# 2. DISPARO DE FORMULÁRIO / LEADS (RESEND)
# Crie uma conta gratuita em https://resend.com e gere uma chave de API com permissão de envio.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# E-mail de destino que receberá os dados dos leads preenchidos no formulário
CONTACT_NOTIFICATION_EMAIL="contato@sotaque.com.br"

# 3. FEED DE INSTAGRAM EM TEMPO REAL (META GRAPH API - OPCIONAL)
# Caso não configurado, o site utiliza automaticamente o mock autoral de alta performance.
# Para ativar a sincronização ao vivo com a API da Meta:
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""

# 4. MONITORAMENTO & ANALYTICS (OPCIONAL)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
